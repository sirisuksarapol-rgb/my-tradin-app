# ==========================================
# Python & Backend Cache (ห้ามดันขึ้น Git)
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
venv/
env/

# ==========================================
# Uploaded Files (รูปภาพที่ผู้ใช้ อัปโหลดลงเครื่อง)
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep

# ==========================================
# Node.js & Frontend Build (ขยะ Frontend)
# ==========================================
node_modules/
dist/
build/
.cache/

# ==========================================
# Environment & Secret Keys (รหัสผ่าน/คีย์ต่างๆ)
# ==========================================
.env
.env.local
.env.development.local
.env.production.local

# ==========================================
# OS & Editor Files (ไฟล์ขยะของระบบปฏิบัติการ)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/